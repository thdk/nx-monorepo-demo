{
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "{projectRoot}/dist",
        "main": "{projectRoot}/src/index.ts",
        "rootDir": "{projectRoot}/src",
        "tsConfig": "{projectRoot}/tsconfig.lib.json",
        "generatePackageJson": false,
        "assets": [
          {
            "input": "{projectRoot}/src",
            "glob": "**/*.json",
            "output": "."
          },
          {
            "input": "{projectRoot}/src",
            "glob": "**/*.d.ts",
            "output": "."
          },
          {
            "input": "{projectRoot}/src",
            "glob": "**/files/**/*",
            "output": "."
          }
        ]
      }
    },
    "nx-release-publish": {
      "dependsOn": ["build"],
      "options": {
        "registry": "https://registry.npmjs.org/",
        "access": "public"
      }
    },
    "publint": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "cwd": "{projectRoot}",
        "command": "publint --strict"
      }
    },
    "check-exports": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "cwd": "{projectRoot}",
        "command": "attw --pack ."
      }
    }
  },
  "tags": ["npm:public", "scope:nx-claude"],
  "name": "nx-claude"
}
