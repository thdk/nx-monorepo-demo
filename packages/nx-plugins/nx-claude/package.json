{
  "name": "@thdk/nx-claude",
  "version": "0.0.1",
  "private": false,
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./version-actions": {
      "development": "./src/version-actions.ts",
      "types": "./dist/version-actions.d.ts",
      "default": "./dist/version-actions.js"
    },
    "./catalog.schema.json": {
      "development": "./src/schemas/catalog.schema.json",
      "default": "./dist/schemas/catalog.schema.json"
    },
    "./executors.json": "./executors.json",
    "./generators.json": "./generators.json"
  },
  "executors": "./executors.json",
  "generators": "./generators.json",
  "files": [
    "dist",
    "!**/*.tsbuildinfo",
    "executors.json",
    "generators.json"
  ],
  "dependencies": {
    "@nx/devkit": "^23.1.0",
    "ajv": "^8.17.1",
    "gray-matter": "^4.0.3",
    "tslib": "2.8.1"
  },
  "peerDependencies": {
    "nx": "^23.0.0-0"
  },
  "devDependencies": {
    "@types/node": "22.15.21"
  }
}
